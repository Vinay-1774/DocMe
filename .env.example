# ==============================================================================
# DocMe — Environment Variables Configuration (.env.example)
# Copy this file to .env and provide your actual configuration values.
# NEVER commit your real .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector / Supabase)
# ------------------------------------------------------------------------------
# Option A: Full connection URI (Recommended for Supabase & Render)
# For Supabase direct connection (Session Pooler or Direct):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# For Supabase Transaction Pooler (Port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Option B: Individual database connection parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=research_platform
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
# Set to 'require' for Supabase / SSL connections, or leave empty for local development
DB_SSLMODE=

# Connection pool settings (Optimized for Supabase free plan connection limits)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT & Cookies)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access and refresh tokens.
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=your_generated_jwt_secret_key_here

# JWT algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Expiration periods
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security:
# Set COOKIE_SECURE=true in production (HTTPS required).
# Set COOKIE_SECURE=false for local development on HTTP.
COOKIE_SECURE=false

# SameSite cookie policy:
# Use 'lax' for local development or same-domain deployment.
# Use 'none' if frontend (e.g., Vercel) and backend (e.g., Render) are on different domains over HTTPS.
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 3. AI & EMBEDDINGS (Google Gemini)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini embedding model (text-embedding-004 outputs 768-dimensional vectors)
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Expected dimension of generated vector embeddings (must match model output, 768 for text-embedding-004)
EMBEDDING_DIMENSION=768

# Gemini conversational model for grounded Q&A
GEMINI_CHAT_MODEL=models/gemini-3.5-flash

# ------------------------------------------------------------------------------
# 4. DOCUMENT PROCESSING & LIMITS
# ------------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_LIMIT=5

# Maximum allowed file upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Directory for uploaded files (relative to project root or absolute)
UPLOAD_DIR=backend/uploads

# ------------------------------------------------------------------------------
# 5. SERVER & CORS SETTINGS
# ------------------------------------------------------------------------------
# Port for Uvicorn server (Render sets PORT automatically)
PORT=8000

# Comma-separated list of allowed frontend origins for CORS
# In production, include your Vercel URL: https://your-project.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 6. EMAIL DELIVERY & OTP VERIFICATION
# ------------------------------------------------------------------------------
# Dedicated secret used for keyed HMAC-SHA256 OTP digests (never logged)
OTP_SECRET_KEY=your_dedicated_otp_hmac_secret_key_here
OTP_VALIDITY_SECONDS=30
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_HOURLY_SENDS=5
REQUIRE_EMAIL_VERIFICATION=true

# SMTP credentials for sending verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 7. OPTIONAL: LANGSMITH TRACING
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=docme-research-platform
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

